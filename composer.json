{
    "type": "library",
    "name": "volmarg/notifier-proxy-logger-bridge",
    "description": "Bridge between NotifierProxyLogger and other projects",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "guzzlehttp/guzzle": "^7.2",
        "lukasoppermann/http-status": "^3.1",
        "monolog/monolog": "^2.2",
        "symfony/cache": "v7.4.0",
        "symfony/config": "v7.4.0",
        "symfony/console": "v7.4",
        "symfony/dependency-injection": "v7.4.0",
        "symfony/dotenv": "v7.4",
        "symfony/error-handler": "v7.4.0",
        "symfony/event-dispatcher": "v7.4.0",
        "symfony/filesystem": "v7.4.0",
        "symfony/finder": "v7.4.0",
        "symfony/framework-bundle": "v7.4.0",
        "symfony/http-foundation": "v7.4.0",
        "symfony/http-kernel": "v7.4.0",
        "symfony/routing": "v7.4.0",
        "symfony/string": "v7.4",
        "symfony/var-dumper": "v7.4",
        "symfony/var-exporter": "v7.4.0",
        "symfony/yaml": "v7.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.1.*"
        }
    },
    "require-dev": {
        "rector/rector": "v2.7.0"
    }
}
